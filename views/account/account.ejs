<h1><%= title %></h1>

<p><%= message %></p>

<p>You are logged in.</p>

<hr>

<h2>Account Management</h2>

<ul>
  <li>
    <a href="/account/update">Update Account Information</a>
  </li>
  <li>
    <a href="/account/update-password">Change Password</a>
  </li>

  <% if (accountData && (accountData.account_type === "Employee" || accountData.account_type === "Admin")) { %>
    <li>
      <a href="/inv/">Inventory Management</a>
    </li>
  <% } %>
</ul>

<hr>

<h2>Your Profile</h2>

<div>

  <!-- Name -->
  <p>
    <strong>Name:</strong> 
    <%= accountData.account_firstname %> 
    <%= accountData.account_lastname %>
  </p>

  <!-- Email -->
  <p>
    <strong>Email:</strong> 
    <%= accountData.account_email %>
  </p>

  <!-- Phone -->
  <% if (accountData.account_phone) { %>
    <p><strong>Phone:</strong> <%= accountData.account_phone %></p>
  <% } else { %>
    <p><strong>Phone:</strong> Not provided</p>
  <% } %>

  <!-- Bio -->
  <% if (accountData.account_bio) { %>
    <p><strong>Bio:</strong> <%= accountData.account_bio %></p>
  <% } else { %>
    <p><strong>Bio:</strong> Not provided</p>
  <% } %>

  <!-- Profile Image -->
  <% if (accountData.account_image) { %>
    <div>
      <p><strong>Profile Image:</strong></p>
      <img 
        src="<%= accountData.account_image %>" 
        alt="Profile Image"
        style="max-width: 200px; border-radius: 10px; margin-top: 10px;"
      >
    </div>
  <% } %>

</div>