<h1><%- title %></h1>

<%- message %>

<form class="login-container" action="/account/login" method="POST">

<div>
    <label for="email">Email Address</label><br>
    <input 
    type="email"
    id="email"
    name="email"
    placeholder="Enter your email">
</div>

<br>
<div>
    <label for="password">Password</label>
    <input 
    type="password"
    id="password"
    name="password"
    placeholder="Enter your password">
</div>

<button type="submit">Login</button>
</form>