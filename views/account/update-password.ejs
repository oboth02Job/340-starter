<h1><%= title %></h1>

<% if (message) { %>
    <p><%= message %></p>
    <% } %>


<% if (errors) { %>
  <ul class="notice">
 <% errors.array().forEach(error => { %>
   <li><%= error.msg %></li>
<%  }) %>
 </ul>
<% } %>

<h2>Change Password</h2>

<form id="passwordForm" action="/account/update-password" method="post">
    <input type="hidden" name="account_id" value="<%= accountData ? accountData.account_id : '' %>">

    <div>
    <label for="account_password">New Password</label><br>
    <input type="password" name="account_password"
     id="accountPassword"
     required
     pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
     title="Password must be at least 12 characters long and contain at least one uppercase letter, one lowercase letter, one number, and one special character.">
     <p>Password must be at least 12 characters long and contain at least one uppercase letter, one lowercase letter, one number, and one special character.</p>
</div>

<button type="submit">Update Password</button>
</form>