<h1><%= title %></h1>

<% if (message) { %>
    <p><%= message %></p>
    <% } %>
     

<% if (errors && errors.length) { %>
  <ul class="notice">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<h2>Account Update</h2>

<form id="loginForm" action="/account/update" method="post">
    <input type="hidden" name="account_id" value="<%= accountData ? accountData.account_id : '' %>">

    <div>
    <label for="account_firstname">First Name</label><br>
    <input type="text" name="account_firstname"
     id="accountFirstname" 
     required value="<%= accountData ? accountData.account_firstname : '' %>">
</div>

<br>
<div>
    <label for="account_lastname">Last Name</label> <br>
    <input type="text" name="account_lastname" id="accountLastname" 
    required value="<%= accountData ? accountData.account_lastname : '' %>">

</div>

<div>
    <label for="account_email">Email Address</label><br>
    <input 
    type="email"
    id="email"
    name="account_email"
    required placeholder="Enter a valid email address"
    value="<%= accountData ? accountData.account_email : '' %>">
</div>

<div>
    <label for="accountPhone">Phone</label><br>
    <input type="tel" name="account_phone"
    placeholder="+256-750-9879"
     id="accountPhone" 
     value="<%= accountData ? accountData.account_phone : '' %>">
</div>

<div>
    <label for="accountBio">Bio</label><br>

<textarea 
  name="account_bio"
  id="accountBio" 
  rows="5" 
  cols="60"><%= accountData ? accountData.account_bio : '' %></textarea>
</div>

<div>
    <label for="account_image">Image</label><br>
    <input type="text" name="account_image"
     id="accountImage" 
     value="<%= accountData ? accountData.account_image : '' %>">
</div>

<button type="submit">Update Account</button>
</form>


<!---------------------------->
<!---Password change Form-->
<!---------------------------->

<h2>Change Password</h2>

<form action="/account/update-password" method="post">

  <label for="account_password">New Password</label>
  <input type="password" name="account_password" id="account_password" required
  placeholder="Enter your password"
    pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
    title="Password must be at least 12 characters long, include a capital letter, a number, and a special character">

  <input type="hidden" name="account_id"
    value="<%= accountData.account_id %>">

  <button type="submit">Change Password</button>
</form>