<h1><%- title %></h1>

<p class="notice"><%- message %></p>


<form method="POST" action="/inv/edit-inventory">

  <label>Classification</label> 
  <%- classificationList %> <br>

  <label>Make</label> 
  <input type="text" name="inv_make" value="<%= inv_make || '' %>"> <br>

  <label>Model</label>
  <input type="text" name="inv_model" value="<%= inv_model || '' %>"> <br>

  <label>Year</label>
  <input type="number" name="inv_year" value="<%= inv_year || '' %>">
<br>
  <label>Price</label>
  <input type="number" name="inv_price" value="<%= inv_price || '' %>"> <br>

  <button type="submit">Edit Vehicle</button>
</form>

<input type="hidden" name="inv_id"
<% if(locals.inv_id) { %> value="<%= locals.inv_id %>"
<% } %>>